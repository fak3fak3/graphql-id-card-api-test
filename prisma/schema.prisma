// Database schema. Models use camelCase in code and snake_case in PostgreSQL
// (@map / @@map), so both sides follow their own conventions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Stated explicitly instead of being inferred from tsconfig.json, so the
  // generated code is identical wherever `prisma generate` runs.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LinkKind {
  GITHUB
  LINKEDIN
  TELEGRAM
  EMAIL
  WEBSITE
  OTHER

  @@map("link_kind")
}

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  INFRASTRUCTURE
  TOOLS

  @@map("skill_category")
}

/// The owner of the business card. The application serves a single profile,
/// but nothing in the schema depends on that.
model Profile {
  id          String @id @default(uuid(7)) @db.Uuid
  name        String
  /// Short professional title shown next to the name.
  headline    String
  description String

  links      ProfileLink[]
  skills     Skill[]
  experience Experience[]
  projects   Project[]

  @@map("profiles")
}

/// A link to a professional resource (GitHub, LinkedIn, ...).
model ProfileLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  kind      LinkKind
  label     String
  url       String
  /// Display order within the profile.
  position  Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Covers the only read path: links of a profile in display order.
  @@index([profileId, position])
  @@map("profile_links")
}

/// A technology or tool the profile owner works with.
model Skill {
  id        String        @id @default(uuid(7)) @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  name      String
  category  SkillCategory
  /// Display order within the profile.
  position  Int

  profile  Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects ProjectSkill[]

  /// Covers the only read path: skills of a profile in display order.
  @@index([profileId, position])
  @@map("skills")
}

/// A place of work. Ordered by start date, so it has no position column.
model Experience {
  id         String    @id @default(uuid(7)) @db.Uuid
  profileId  String    @map("profile_id") @db.Uuid
  company    String
  companyUrl String?   @map("company_url")
  /// Job title.
  position   String
  startDate  DateTime  @map("start_date") @db.Date
  /// NULL means "to the present day".
  endDate    DateTime? @map("end_date") @db.Date

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  /// Covers the only read path: experience of a profile, newest first.
  @@index([profileId, startDate(sort: Desc)])
  @@map("experiences")
}

/// Something accomplished at a place of work.
model Achievement {
  id           String @id @default(uuid(7)) @db.Uuid
  experienceId String @map("experience_id") @db.Uuid
  text         String
  /// Display order within the experience.
  position     Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  /// Covers the only read path: achievements of experiences in display order.
  @@index([experienceId, position])
  @@map("achievements")
}

/// Something the profile owner has built.
model Project {
  id            String  @id @default(uuid(7)) @db.Uuid
  profileId     String  @map("profile_id") @db.Uuid
  name          String
  description   String
  /// Public address of the project, if it has one.
  url           String?
  /// Source code, if it is public.
  repositoryUrl String? @map("repository_url")
  /// Display order within the profile.
  position      Int

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills  ProjectSkill[]

  /// Covers the only read path: projects of a profile in display order.
  @@index([profileId, position])
  @@map("projects")
}

/// Many-to-many link: which skills a project was built with. An explicit model
/// rather than Prisma's implicit one, to control table and column names.
model ProjectSkill {
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// The primary key serves "skills of a project"...
  @@id([projectId, skillId])
  /// ...and this index serves the opposite direction, "projects of a skill".
  @@index([skillId])
  @@map("project_skills")
}
