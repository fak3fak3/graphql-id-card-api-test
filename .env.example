# Optional: every variable has a working default.
# Copy to .env only if you want to change something: cp .env.example .env

# ---- Application (npm run start:dev on the host) ---------------------------

# development | test | production
NODE_ENV=development

# HTTP port of the application
PORT=3000

# PostgreSQL connection string (required).
# Points at the "db" service from compose.yaml, published on DB_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/id_card

# Apollo Sandbox and schema introspection at /graphql (true | false)
GRAPHQL_SANDBOX=true

# Log every SQL query (true | false): shows how many queries an operation costs
DATABASE_LOG_QUERIES=false

# ---- Docker Compose ---------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=id_card

# Host ports
APP_PORT=3000
DB_PORT=5433
