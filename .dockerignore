# Everything the image build does not need. Keeps the build context small and
# makes sure local secrets and artifacts never end up in a layer.
.git
.gitignore
.gitattributes
.editorconfig
.nvmrc
.vscode
.idea

node_modules
dist
src/generated
coverage
*.tsbuildinfo
*.log

.env
.env.*
!.env.example

Dockerfile
.dockerignore
compose.yaml
README.md
test
